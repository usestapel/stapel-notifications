#: notification.billing.payment_succeeded.subject
msgid "Payment received: {amount}"
msgstr "Pago recibido: {amount}"

#: notification.billing.payment_succeeded.heading
msgid "Thank you — your payment went through"
msgstr "Gracias: tu pago se ha realizado"

#: notification.billing.payment_succeeded.body
msgid "We received your payment of {amount} for {item_name}."
msgstr "Hemos recibido tu pago de {amount} por {item_name}."

#: notification.billing.payment_succeeded.period
msgid "This covers the period from {period_start} to {period_end}."
msgstr "Cubre el periodo del {period_start} al {period_end}."

#: notification.billing.payment_succeeded.cta
msgid "View your invoice"
msgstr "Ver la factura"

#: notification.billing.payment_succeeded.note
msgid "Keep this email for your records. If you do not recognise this payment, contact support and we will look into it."
msgstr "Guarda este correo como comprobante. Si no reconoces este pago, escribe al servicio de asistencia y lo revisaremos."

#: notification.billing.payment_failed.subject
msgid "Your payment of {amount} did not go through"
msgstr "Tu pago de {amount} no se ha realizado"

#: notification.billing.payment_failed.heading
msgid "We could not take your payment"
msgstr "No hemos podido cobrar tu pago"

#: notification.billing.payment_failed.body
msgid "We tried to charge {amount} for {item_name}, and the payment was declined."
msgstr "Hemos intentado cobrar {amount} por {item_name} y el pago fue rechazado."

#: notification.billing.payment_failed.reason
msgid "Reason given by your bank: {decline_reason}"
msgstr "Motivo indicado por tu banco: {decline_reason}"

#: notification.billing.payment_failed.cta
msgid "Update your payment method"
msgstr "Actualizar tu método de pago"

#: notification.billing.payment_failed.note
msgid "Nothing has been charged and nothing has been lost. We will try again automatically, or you can update your card using the button above."
msgstr "No se ha cobrado nada y no has perdido nada. Lo intentaremos de nuevo automáticamente, o puedes actualizar tu tarjeta con el botón de arriba."

#: notification.billing.subscription_ending.subject
msgid "Your {item_name} subscription ends on {period_end}"
msgstr "Tu suscripción {item_name} termina el {period_end}"

#: notification.billing.subscription_ending.heading
msgid "Your subscription will not renew"
msgstr "Tu suscripción no se renovará"

#: notification.billing.subscription_ending.body
msgid "Your {item_name} subscription is set to end and will not renew. You will not be charged again."
msgstr "Tu suscripción {item_name} va a terminar y no se renovará. No se te volverá a cobrar."

#: notification.billing.subscription_ending.period
msgid "You keep full access until {period_end}."
msgstr "Mantienes el acceso completo hasta el {period_end}."

#: notification.billing.subscription_ending.cta
msgid "Keep my subscription"
msgstr "Mantener mi suscripción"

#: notification.billing.subscription_ending.note
msgid "If you changed your mind, use the button above before the date shown and nothing will be interrupted."
msgstr "Si has cambiado de opinión, usa el botón de arriba antes de esa fecha y no se interrumpirá nada."
