#: notification.magic_link_login.subject
msgid "Your {company_name} sign-in link"
msgstr "Twój link do logowania w {company_name}"

#: notification.magic_link_login.heading
msgid "Sign in to {company_name}"
msgstr "Zaloguj się do {company_name}"

#: notification.magic_link_login.body
msgid "Click the button below to sign in. This link expires in 15 minutes and can only be used once."
msgstr "Kliknij poniższy przycisk, aby się zalogować. Link wygasa za 15 minut i może być użyty tylko raz."

#: notification.magic_link_login.warning
msgid "If you didn't request this, you can safely ignore this email."
msgstr "Jeśli ta prośba nie pochodzi od Ciebie, możesz spokojnie zignorować tę wiadomość."

#: notification.new_device_login.subject
msgid "New sign-in to your account"
msgstr "Nowe logowanie na Twoje konto"

#: notification.new_device_login.heading
msgid "New sign-in detected"
msgstr "Wykryto nowe logowanie"

#: notification.new_device_login.body
msgid "Your account was signed in from a new device.\n\nDevice: {device_name}\nIP: {ip_address}"
msgstr "Na Twoje konto zalogowano się z nowego urządzenia.\n\nUrządzenie: {device_name}\nIP: {ip_address}"

#: notification.new_device_login.cta
msgid "Secure my account"
msgstr "Zabezpiecz moje konto"

#: notification.new_device_login.warning
msgid "If this was you, no action is needed. If you don't recognise this sign-in, secure your account immediately."
msgstr "Jeśli to Ty, nie musisz nic robić. Jeśli nie rozpoznajesz tego logowania, natychmiast zabezpiecz swoje konto."

#: notification.suspicious_login.subject
#: notification.suspicious_login.heading
msgid "Suspicious sign-in detected"
msgstr "Wykryto podejrzane logowanie"

#: notification.suspicious_login.badge
msgid "Security alert"
msgstr "Alert bezpieczeństwa"

#: notification.suspicious_login.body
msgid "A sign-in from an unrecognised location was detected on your account.\n\nDevice: {device_name}\nIP: {ip_address}"
msgstr "Na Twoim koncie wykryto logowanie z nieznanej lokalizacji.\n\nUrządzenie: {device_name}\nIP: {ip_address}"

#: notification.suspicious_login.cta
msgid "This wasn't me — revoke all sessions"
msgstr "To nie ja — unieważnij wszystkie sesje"

#: notification.suspicious_login.warning
msgid "If this was you, no action is needed. If not, click the button above immediately to revoke all sessions."
msgstr "Jeśli to Ty, nie musisz nic robić. Jeśli nie, natychmiast kliknij przycisk powyżej, aby unieważnić wszystkie sesje."

#: notification.all_sessions_revoked.subject
msgid "All sessions revoked"
msgstr "Unieważniono wszystkie sesje"

#: notification.all_sessions_revoked.heading
msgid "All sessions have been revoked"
msgstr "Wszystkie sesje zostały unieważnione"

#: notification.all_sessions_revoked.body
msgid "All active sessions on your account have been revoked. You have been signed out of all devices."
msgstr "Wszystkie aktywne sesje na Twoim koncie zostały unieważnione. Wylogowano Cię ze wszystkich urządzeń."

#: notification.all_sessions_revoked.warning
msgid "If you did not initiate this action, please reset your password immediately."
msgstr "Jeśli ta akcja nie została zainicjowana przez Ciebie, natychmiast zresetuj hasło."

#: notification.billing.payment_succeeded.subject
msgid "Payment received: {amount}"
msgstr "Otrzymaliśmy płatność: {amount}"

#: notification.billing.payment_succeeded.heading
msgid "Thank you — your payment went through"
msgstr "Dziękujemy — płatność zakończyła się powodzeniem"

#: notification.billing.payment_succeeded.body
msgid "We received your payment of {amount} for {item_name}."
msgstr "Otrzymaliśmy Twoją płatność w wysokości {amount} za {item_name}."

#: notification.billing.payment_succeeded.period
msgid "This covers the period from {period_start} to {period_end}."
msgstr "Płatność obejmuje okres od {period_start} do {period_end}."

#: notification.billing.payment_succeeded.cta
msgid "View your invoice"
msgstr "Zobacz fakturę"

#: notification.billing.payment_succeeded.note
msgid "Keep this email for your records. If you do not recognise this payment, contact support and we will look into it."
msgstr "Zachowaj tę wiadomość na potrzeby swojej dokumentacji. Jeśli nie rozpoznajesz tej płatności, skontaktuj się z pomocą techniczną, a my to sprawdzimy."

#: notification.billing.payment_failed.subject
msgid "Your payment of {amount} did not go through"
msgstr "Płatność w wysokości {amount} nie powiodła się"

#: notification.billing.payment_failed.heading
msgid "We could not take your payment"
msgstr "Nie udało się pobrać płatności"

#: notification.billing.payment_failed.body
msgid "We tried to charge {amount} for {item_name}, and the payment was declined."
msgstr "Próbowaliśmy pobrać {amount} za {item_name}, ale płatność została odrzucona."

#: notification.billing.payment_failed.reason
msgid "Reason given by your bank: {decline_reason}"
msgstr "Powód podany przez Twój bank: {decline_reason}"

#: notification.billing.payment_failed.cta
msgid "Update your payment method"
msgstr "Zaktualizuj metodę płatności"

#: notification.billing.payment_failed.note
msgid "Nothing has been charged and nothing has been lost. We will try again automatically, or you can update your card using the button above."
msgstr "Nie pobraliśmy żadnych środków i nic nie przepadło. Spróbujemy ponownie automatycznie — możesz też zaktualizować kartę za pomocą przycisku powyżej."

#: notification.billing.payment_failed.final_note
msgid "This was our last automatic attempt — we will not try to take this payment again. To keep your plan, update your payment method using the button above."
msgstr "To była nasza ostatnia automatyczna próba — nie będziemy już ponawiać tej płatności. Aby zachować swój plan, zaktualizuj metodę płatności za pomocą przycisku powyżej."

#: notification.billing.subscription_ending.subject
msgid "Your {item_name} subscription ends on {period_end}"
msgstr "Twoja subskrypcja {item_name} kończy się {period_end}"

#: notification.billing.subscription_ending.heading
msgid "Your subscription will not renew"
msgstr "Twoja subskrypcja nie zostanie odnowiona"

#: notification.billing.subscription_ending.body
msgid "Your {item_name} subscription is set to end and will not renew. You will not be charged again."
msgstr "Twoja subskrypcja {item_name} wkrótce się zakończy i nie zostanie odnowiona. Nie pobierzemy już żadnych opłat."

#: notification.billing.subscription_ending.period
msgid "You keep full access until {period_end}."
msgstr "Pełny dostęp zachowasz do {period_end}."

#: notification.billing.subscription_ending.cta
msgid "Keep my subscription"
msgstr "Zachowaj subskrypcję"

#: notification.billing.subscription_ending.note
msgid "If you changed your mind, use the button above before the date shown and nothing will be interrupted."
msgstr "Jeśli zmienisz zdanie, użyj przycisku powyżej przed podaną datą, a nic nie zostanie przerwane."

#: notification.footer.consent
msgid "You received this email because you agreed to receive messages from {company_name}."
msgstr "Otrzymujesz tę wiadomość na podstawie Twojej zgody na otrzymywanie wiadomości od {company_name}."

#: notification.footer.unsubscribe
msgid "Unsubscribe"
msgstr "Wypisz się"

#: notification.footer.manage
msgid "Manage notifications"
msgstr "Zarządzaj powiadomieniami"
